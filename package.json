{
  "name": "jan-rakshak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"tsx server/src/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx server/src/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/src/index.ts --production",
    "seed": "tsx server/src/seed.ts",
    "create-admin": "tsx server/src/create-admin.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "verify:risk-model": "tsx server/scripts/verify-risk-model.ts",
    "test:risk": "tsx server/scripts/test-risk-integration.ts",
    "test:allocation": "tsx server/scripts/test-hungarian.ts && tsx server/scripts/test-allocation.ts && tsx server/scripts/test-allocation-db.ts",
    "bench:allocation": "tsx server/scripts/benchmark-allocation.ts",
    "test:location-dedup": "tsx server/scripts/test-location.ts && tsx server/scripts/test-dedup.ts && tsx server/scripts/test-dedup-db.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@electric-sql/pglite": "^0.5.8",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "framer-motion": "^13.4.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
