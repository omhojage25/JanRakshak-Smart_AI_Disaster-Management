# Copy to .env and fill in. Only JWT_SECRET is required in production.

# --- AI classification ---
GEMINI_API_KEY=
# Primary model, then fallbacks tried when a model is overloaded (503) or rate-limited (429).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# --- Auth ---
# Random string, at least 32 characters. Changing it signs everyone out.
JWT_SECRET=
# Defaults to true in production. Set to true whenever the site is served over HTTPS.
# COOKIE_SECURE=true

# --- Database ---
# Leave empty to use the embedded PostgreSQL (PGlite) stored in server/data/pgdata.
# Set to use a real PostgreSQL server instead, e.g. postgres://user:pass@host:5432/janrakshak
DATABASE_URL=
# DB_POOL_MAX=10

# --- Server ---
PORT=3001
# Dev only: port for the Vite dev server.
# VITE_PORT=5173
# Set when running behind a reverse proxy (e.g. 1 or "loopback") so client IPs are correct.
# TRUST_PROXY=1

# --- Notifications ---
# Optional: every warning/critical alert is POSTed here as JSON with a "text" field
# (works directly with Slack/Teams incoming webhooks, or your own SMS gateway).
NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_MIN_LEVEL=warning

# --- Demo vehicle simulation ---
# When true, dispatched vehicles that are not sending live GPS drive along their road route
# (shown with a SIM badge). Real GPS always takes priority. Keep false in production.
SIMULATE_VEHICLES=false
# SIMULATION_SPEED_KMH=60

# --- Location lookup ---
# Place names from reports are checked against OpenStreetMap Nominatim (about 1 lookup/second on the
# public server). Point NOMINATIM_URL at a self-hosted instance for production volumes.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMINATIM_EMAIL=
# SERVICE_CITY=Mumbai
# Service area as west,north,east,south; locations outside it are ignored.
# SERVICE_AREA_BOUNDS=72.75,19.35,73.15,18.85

# --- Maps ---
# The public OSRM demo server is rate limited; point this at a self-hosted OSRM for production.
# OSRM_URL=https://router.project-osrm.org
# Where reports with no identifiable location are pinned.
# DEFAULT_CITY_LAT=19.076
# DEFAULT_CITY_LNG=72.8777

# --- First run in production ---
# Demo passwords used by "npm run seed" (otherwise Admin@12345 / Coord@12345 / Field@12345).
# SEED_ADMIN_PASSWORD=
# SEED_COORDINATOR_PASSWORD=
# SEED_FIELD_PASSWORD=

# Road routing for allocation, the coordinator map and the field-unit screen (OSRM HTTP API).
# A self-hosted OSRM (Docker, India/Mumbai extract) is preferred for demos; the public demo server
# https://router.project-osrm.org has usage limits and no uptime guarantee. Without ROUTING_URL,
# allocation runs are marked DEGRADED (there is no straight-line fallback).
ROUTING_URL=https://router.project-osrm.org
ROUTING_BACKEND=osrm
ROUTING_TIMEOUT_MS=8000
